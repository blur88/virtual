{
  "agent": "riley",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git -C * status*)",
      "Bash(git -C * branch*)",
      "Bash(git -C * log*)",
      "Bash(git -C * rev-parse*)",
      "Bash(ls *)",
      "Bash(test *)"
    ],
    "deny": [
      "Write",
      "Edit",
      "MultiEdit",
      "NotebookEdit",
      "Agent",
      "Task",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(mkdir *)",
      "Bash(rmdir *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(ln *)",
      "Bash(tee *)",
      "Bash(dd *)",
      "Bash(truncate *)",
      "Bash(sed -i*)",
      "Bash(perl -i*)",
      "Bash(python* -c*)",
      "Bash(node -e*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git init*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git reset*)",
      "Bash(git clean*)",
      "Bash(git rm*)",
      "Bash(git mv*)",
      "Bash(* > *)",
      "Bash(* >> *)"
    ]
  }
}
